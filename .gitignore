# ============================================
# Alurkerja Addon - .gitignore
# ============================================
# Siyo file/folder: build artifacts, dependencies, lockfiles, OS/editor temp.

# --- Dependencies / vendor (STAY OUT of the repo) ---
node_modules/
views/node_modules/
**/node_modules/

# --- Build output (regenerated by npm run build / build.sh) ---
views/dist/
dist/
build/

# --- Generated lockfiles (recreate from package.json) ---
views/yarn.lock
views/package-lock.json
yarn.lock
package-lock.json

# --- Python cache (scripts/) ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# --- OS / editor temporary files ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.idea/
.vscode/settings.json
*.log

# --- Logs, temp, local-only helpers ---
*.tmp
*.temp
*.bak
logs/
temp/
